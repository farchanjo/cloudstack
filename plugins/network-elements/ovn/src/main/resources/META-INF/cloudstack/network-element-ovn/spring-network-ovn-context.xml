<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:aop="http://www.springframework.org/schema/aop"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                      http://www.springframework.org/schema/beans/spring-beans.xsd
                      http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop.xsd
                      http://www.springframework.org/schema/context
                      http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- NIC tunable ConfigKey registry + resolution chain. -->
    <bean id="ovnNicConfig" class="com.cloud.network.ovn.config.OvnNicConfig"/>

    <!-- Network-wide ConfigKey registry: public localnet VLAN auto + BGP /32 redistribute. -->
    <bean id="ovnNetworkConfig" class="com.cloud.network.ovn.config.OvnNetworkConfig"/>

    <!-- Persistence (Phase I.2). -->
    <bean id="ovnControllerDaoImpl" class="com.cloud.network.ovn.dao.OvnControllerDaoImpl"/>
    <bean id="ovnChassisMapDaoImpl" class="com.cloud.network.ovn.dao.OvnChassisMapDaoImpl"/>
    <bean id="ovnLogicalIdMapDaoImpl" class="com.cloud.network.ovn.dao.OvnLogicalIdMapDaoImpl"/>
    <!-- Phase H.2: persistent retry queue for failed OVN NB DB deletions. -->
    <bean id="ovnPendingDeletionDaoImpl" class="com.cloud.network.ovn.dao.OvnPendingDeletionDaoImpl"/>

    <!-- Composition root + element/guru/services (Phase I.4). -->
    <bean id="ovnPluginManager" class="com.cloud.network.ovn.manager.OvnPluginManager"/>

    <bean id="Ovn" class="com.cloud.network.ovn.element.OvnNetworkElement">
        <property name="name" value="Ovn"/>
    </bean>

    <bean id="ovnGuestNetworkGuru" class="com.cloud.network.ovn.element.OvnGuestNetworkGuru">
        <property name="name" value="OvnGuestNetworkGuru"/>
    </bean>

    <bean id="ovnVpcElement" class="com.cloud.network.ovn.element.OvnVpcElement"/>
    <bean id="ovnSourceNatService" class="com.cloud.network.ovn.element.OvnSourceNatService"/>
    <bean id="ovnStaticNatService" class="com.cloud.network.ovn.element.OvnStaticNatService"/>

    <!-- Admin API service (Phase I.5). -->
    <bean id="ovnAdminService" class="com.cloud.network.ovn.manager.OvnAdminServiceImpl"/>

    <!-- CKS worker NIC discovery for auto ECMP / auto LB (optional k8s DAOs). -->
    <bean id="ovnCksWorkerDiscovery" class="com.cloud.network.ovn.manager.OvnCksWorkerDiscovery"/>

    <!-- On-demand orphan / stale-mapping reaper (admin runOvnReconciler API). -->
    <bean id="ovnReconcilerService" class="com.cloud.network.ovn.manager.OvnReconcilerService"/>

    <!-- importOvnVpc adoption pipeline (Phase I.5). -->
    <bean id="ovnVpcImporter" class="com.cloud.network.ovn.manager.OvnVpcImporter"/>

    <!-- Chassis registration (Phase I.6). -->
    <bean id="ovnChassisRegistrationService" class="com.cloud.network.ovn.manager.OvnChassisRegistrationService"/>

    <!-- AgentManager host-event subscriber that drives the registration service. -->
    <bean id="ovnChassisListener" class="com.cloud.network.ovn.manager.OvnChassisListener"/>

    <!-- Phase 2 — NetworkACL programming (item 4). -->
    <bean id="ovnFirewallService" class="com.cloud.network.ovn.element.OvnFirewallService">
        <property name="name" value="OvnFirewallService"/>
    </bean>

    <!-- Phase 2 — Load balancer programming (item 5). -->
    <bean id="ovnLoadBalancerService" class="com.cloud.network.ovn.element.OvnLoadBalancerService">
        <property name="name" value="OvnLoadBalancerService"/>
    </bean>
    <!-- DSR_SOFTWARE programmer: never creates OVN Load_Balancer / NAT. -->
    <bean id="dsrSoftwareLbService" class="com.cloud.network.ovn.element.DsrSoftwareLbService">
        <property name="name" value="DsrSoftwareLbService"/>
    </bean>

    <!-- Phase 3 — DHCP / DNS / PF / QoS / Public network helpers. -->
    <bean id="ovnDhcpService" class="com.cloud.network.ovn.element.OvnDhcpService"/>
    <bean id="ovnDnsService" class="com.cloud.network.ovn.element.OvnDnsService"/>
    <bean id="ovnPortForwardingService" class="com.cloud.network.ovn.element.OvnPortForwardingService"/>
    <bean id="ovnQosService" class="com.cloud.network.ovn.element.OvnQosService"/>
    <bean id="ovnPublicNetworkManager" class="com.cloud.network.ovn.element.OvnPublicNetworkManager"/>

    <!-- BGP /32 redistribute on the OVN gateway-chassis (opt-in via
         ovn.bgp.redistribute.public_ips). -->
    <bean id="ovnBgpRedistributeManager"
          class="com.cloud.network.ovn.manager.OvnBgpRedistributeManager"/>
    <!-- Shared fail-closed leader election for the plugin's periodic loops
         (multi-node management cluster: only one node drives reconcile /
         pending-deletion passes). -->
    <bean id="ovnReconcileLeader"
          class="com.cloud.network.ovn.manager.OvnReconcileLeader"/>
    <bean id="ovnBgpReconcileTask"
          class="com.cloud.network.ovn.manager.OvnBgpReconcileTask"/>

    <!-- Phase H.2: background processor for the OVN pending-deletion retry queue. -->
    <bean id="ovnPendingDeletionProcessor"
          class="com.cloud.network.ovn.manager.OvnPendingDeletionProcessor"/>

</beans>
